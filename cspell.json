{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "ignorePaths": [
    "dist",
    "dev-dist",
    "node_modules",
    "patches",
    "pnpm-lock.yaml"
  ],
  "import": ["@cspell/dict-fr-fr/cspell-ext.json"],
  "language": "en,en-GB",
  "overrides": [
    {
      "filename": "**/i18n/dictionary-fr.ts",
      "language": "en,en-GB,fr"
    }
  ],
  "version": "0.2",
  "words": [
    "adrienlcp",
    "Akari",
    "appinstalled",
    "beforeinstallprompt",
    "biomejs",
    "esbuild",
    "Hashi",
    "IHDR",
    "Lacourpaille",
    "noindex",
    "Nonogram",
    "Numberlink",
    "OKLCH",
    "picross",
    "precaching",
    "vite",
    "PRNG",
    "Sokoban",
    "WCAG"
  ]
}
