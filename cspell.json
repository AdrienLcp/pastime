{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "ignorePaths": [
    "dev-dist",
    "dist",
    "node_modules",
    "patches",
    "pnpm-lock.yaml",
    "public/fonts/*-OFL.txt"
  ],
  "ignoreRegExpList": ["'[A-L]{5,12}( [.*x]{5,12})?'"],
  "import": ["@cspell/dict-fr-fr/cspell-ext.json"],
  "language": "en,en-GB",
  "overrides": [
    {
      "filename": "index.html",
      "language": "en,en-GB,fr"
    },
    {
      "filename": "src/infrastructure/pwa/web-app-manifest.ts",
      "language": "en,en-GB,fr"
    },
    {
      "filename": "**/i18n/dictionary-fr.ts",
      "language": "en,en-GB,fr"
    },
    {
      "filename": "DESIGN.md",
      "language": "en,en-GB,fr"
    }
  ],
  "version": "0.2",
  "words": [
    "adrienlcp",
    "Akari",
    "appinstalled",
    "Archivo",
    "archivo",
    "Arimo",
    "backface",
    "beforeinstallprompt",
    "biomejs",
