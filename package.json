  "scripts": {
    "build": "pnpm typecheck && vite build",
    "deps:upgrade": "corepack use pnpm@latest && pnpm up -L && biome migrate --write",
    "dev": "vite",
    "icons": "node scripts/icons/render.mjs",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preview": "vite preview --port 5531 --strictPort",
    "spell": "cspell --no-progress --gitignore \"**\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/service-worker",
    "validate": "pnpm lint:ci && pnpm spell && pnpm build && pnpm test"
  },
