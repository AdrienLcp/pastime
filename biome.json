{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["@adrienlcp/biome-config", "@adrienlcp/biome-config/react"],
  "files": {
    "includes": ["!.claude/skills", "!**/dev-dist"]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "Date": "Read the time through infrastructure/clock.ts, parse or build a Date through infrastructure/dates.ts."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/infrastructure/clock.ts", "**/infrastructure/dates.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
